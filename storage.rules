rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to upload files to infinite-drill-uploads
    // Path structure: infinite-drill-uploads/{userId}/{timestamp}.{extension}
    match /infinite-drill-uploads/{userId}/{fileName} {
      // Allow upload/read only if user is authenticated and matches the userId in path
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

